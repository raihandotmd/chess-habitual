{
    "manifest_version": 3,
    "name": "Chess.com Habits Reminder",
    "version": "1.0.0",
    "description": "A simple reminder of chess habits to follow during games on Chess.com",
    "icons": {
        "16": "icons/icon16.png",
        "64": "icons/icon64.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "64": "icons/icon64.png",
            "128": "icons/icon128.png"
          }
    },
    "content_scripts": [
        {
            "matches": ["*://*.chess.com/*"],
            "js": ["content/content.js"],
            "css": ["content/content.css"]
        }
    ],
    "permissions": ["storage", "tabs"],
    "background": {
        "service_worker": "background/background.js"
    }
}
